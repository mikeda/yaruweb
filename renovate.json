{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": ["renovate"],
  "extends": ["config:base", ":timezone(Asia/Tokyo)", ":prHourlyLimitNone", ":automergePatch"],
  "ignorePaths": [".github/workflows/ci.yml"],
  "schedule": ["after 3am on saturday", "before 8am on saturday"],
  "dependencyDashboard": true,
  "branchConcurrentLimit": 0,
  "packageRules": [
    {
      "groupName": "eslint",
      "matchPackagePatterns": ["eslint"]
    },
    {
      "groupName": "storybook-addon",
      "matchPackagePatterns": ["storybook-addon"]
    },
    {
      "groupName": "types",
      "matchPackagePatterns": ["^@types/"]
    },
    {
      "groupName": "fortawesome",
      "matchPackagePatterns": ["fortawesome"]
    },
    {
      "groupName": "sentry",
      "matchPackagePatterns": ["^@sentry"]
    }
  ]
}
